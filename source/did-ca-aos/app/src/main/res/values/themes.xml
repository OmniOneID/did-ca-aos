<resources>

    <style name="Base.Theme.DidCa" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_pale</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>

        <item name="colorSecondary">@color/brand_primary_light</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorError">@color/brand_error</item>

        <item name="android:colorBackground">@color/brand_surface</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/brand_text_secondary</item>
        <item name="colorOutline">@color/brand_divider</item>

        <item name="android:statusBarColor">@color/brand_surface</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="fontFamily">@font/pretendard_regular</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.DidCa.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.DidCa.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.DidCa.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.DidCa.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.DidCa.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.DidCa.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.DidCa.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.DidCa.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.DidCa.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.DidCa.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.DidCa.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.DidCa.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.DidCa.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.DidCa.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.DidCa.LabelSmall</item>

        <item name="materialButtonStyle">@style/Widget.DidCa.Button.Primary</item>
    </style>

    <style name="Theme.DidCa" parent="Base.Theme.DidCa" />

    <style name="Theme.DidCa.Docs" parent="Theme.DidCa">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="ThemeOverlay.DidCa.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.DidCa.BottomSheet</item>
    </style>

    <style name="Widget.DidCa.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@null</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <style name="TextAppearance.DidCa.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="fontFamily">@font/pretendard_bold</item>
    </style>
    <style name="TextAppearance.DidCa.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="fontFamily">@font/pretendard_bold</item>
    </style>
    <style name="TextAppearance.DidCa.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="fontFamily">@font/pretendard_bold</item>
    </style>
    <style name="TextAppearance.DidCa.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
    </style>
    <style name="TextAppearance.DidCa.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
    </style>
    <style name="TextAppearance.DidCa.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
    </style>
    <style name="TextAppearance.DidCa.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
    </style>
    <style name="TextAppearance.DidCa.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
    </style>
    <style name="TextAppearance.DidCa.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
    </style>
    <style name="TextAppearance.DidCa.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="fontFamily">@font/pretendard_regular</item>
    </style>
    <style name="TextAppearance.DidCa.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="fontFamily">@font/pretendard_regular</item>
    </style>
    <style name="TextAppearance.DidCa.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="fontFamily">@font/pretendard_regular</item>
    </style>
    <style name="TextAppearance.DidCa.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
    </style>
    <style name="TextAppearance.DidCa.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
    </style>
    <style name="TextAppearance.DidCa.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
    </style>


    <style name="Widget.DidCa.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.DidCa.Button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/btn_primary_background_tint</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.DidCa.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.DidCa.Button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <style name="TextAppearance.DidCa.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <style name="TextAppearance.DidCa.Title" parent="TextAppearance.DidCa.HeadlineSmall">
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:textSize">22sp</item>
    </style>


    <style name="TextAppearance.DidCa.ItemTitle" parent="TextAppearance.DidCa.TitleSmall">
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.DidCa.ItemDesc" parent="TextAppearance.DidCa.BodySmall">
        <item name="android:textColor">@color/brand_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.DidCa.StepLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="fontFamily">@font/pretendard_bold</item>
        <item name="android:textColor">@color/brand_text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.15</item>
    </style>

    <style name="TextAppearance.DidCa.StepNumber" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="fontFamily">@font/pretendard_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
    </style>


    <style name="Widget.DidCa.NumPadKey" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_numpad_key</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
    </style>

    <style name="Widget.DidCa.NumPadKey.Icon" parent="Widget.DidCa.NumPadKey">
        <item name="android:scaleType">center</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Widget.DidCa.NumPadKey.Empty" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
    </style>
</resources>
