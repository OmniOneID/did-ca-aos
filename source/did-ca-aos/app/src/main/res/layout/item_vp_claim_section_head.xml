<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/sectionHeadTopDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/brand_divider"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/sectionHeadRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/sectionHeadLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_extrabold"
            android:letterSpacing="0.055"
            android:textAllCaps="true"
            android:textColor="@color/brand_text_secondary"
            android:textSize="11sp"
            tools:text="Optional" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/selectAllRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text="@string/vp_request_select_all"
                android:textColor="@color/brand_primary"
                android:textSize="11sp" />

            <FrameLayout
                android:id="@+id/selectAllBox"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_vp_checkbox_small_off"
                android:contentDescription="@string/vp_request_select_all">

                <ImageView
                    android:id="@+id/selectAllCheckIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_check_small"
                    android:visibility="gone"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
