<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/rowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/pretendard_semibold"
                android:textColor="@color/brand_text_primary"
                android:textSize="13sp"
                tools:text="API Gateway" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rowActionButton"
                style="@style/Widget.DidCa.Button.ServerUrlRow.Muted"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/server_url_row_default" />
        </LinearLayout>

        <EditText
            android:id="@+id/rowInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:autofillHints=""
            android:background="@drawable/bg_text_field"
            android:fontFamily="@font/pretendard_regular"
            android:gravity="center_vertical"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/brand_text_primary"
            android:textSize="14sp"
            tools:text="http://10.0.0.5:8093" />

        <TextView
            android:id="@+id/rowError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/pretendard_regular"
            app:lineHeight="16.8sp"
            android:textColor="@color/brand_error"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Enter a URL."
            tools:visibility="visible" />
    </LinearLayout>

    <View
        android:id="@+id/rowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/brand_divider" />
</LinearLayout>
