<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/bottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enableButton"
            style="@style/Widget.DidCa.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/biometric_enable" />

        <TextView
            android:id="@+id/secondaryButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_text_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:textColor="@color/brand_primary"
            android:textSize="16sp"
            tools:text="Skip" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/bioContainer"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:background="@drawable/bg_biometric_circle">

            <FrameLayout
                android:id="@+id/bioClip"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="14dp"
                tools:ignore="UselessParent">

                <LinearLayout
                    android:id="@+id/bioRow"
                    android:layout_width="600dp"
                    android:layout_height="200dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:contentDescription="@null"
                        android:padding="52dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_finger_large" />

                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:contentDescription="@null"
                        android:padding="52dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_face" />

                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:contentDescription="@null"
                        android:padding="52dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_finger_large" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center"
            android:text="@string/biometric_setup_title"
            android:textColor="@color/brand_text_primary"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/pretendard_regular"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:paddingHorizontal="16dp"
            android:text="@string/biometric_setup_desc"
            android:textColor="@color/brand_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
