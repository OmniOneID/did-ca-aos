<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/credentialCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_credential_card"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:orientation="vertical"
    android:outlineSpotShadowColor="@color/brand_card_shadow"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_credential_icon">

            <ImageView
                android:id="@+id/credentialIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_id"
                app:tint="@color/brand_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/credentialIssuer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/pretendard_medium"
                android:letterSpacing="0.018"
                android:maxLines="1"
                android:textColor="@color/brand_text_secondary"
                android:textSize="11sp"
                tools:text="Government Identity Service" />

            <TextView
                android:id="@+id/credentialName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/pretendard_bold"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/brand_text_primary"
                android:textSize="14sp"
                tools:text="National ID Card" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chev_r"
            app:tint="@color/brand_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/badgeRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_status_active"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_status_dot_active" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:letterSpacing="0.027"
                android:textColor="@color/status_active_fg"
                android:textSize="11sp"
                tools:text="Active" />
        </LinearLayout>

        <TextView
            android:id="@+id/formatBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_badge_vc"
            android:fontFamily="@font/pretendard_semibold"
            android:letterSpacing="0.027"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:textColor="@color/badge_vc_fg"
            android:textSize="11sp"
            tools:text="VC" />

        <TextView
            android:id="@+id/zkpBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_zkp"
            android:fontFamily="@font/pretendard_semibold"
            android:letterSpacing="0.027"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="ZKP"
            android:textColor="@color/badge_zkp_fg"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/divider_dashed"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:letterSpacing="0.04"
                android:text="@string/docs_issued_label"
                android:textColor="@color/brand_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/credentialIssued"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/pretendard_semibold"
                android:textColor="@color/brand_text_primary"
                android:textSize="12sp"
                tools:text="20 Dec 2024" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:letterSpacing="0.04"
                android:text="@string/docs_valid_label"
                android:textColor="@color/brand_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/credentialValid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/pretendard_semibold"
                android:textColor="@color/brand_text_primary"
                android:textSize="12sp"
                tools:text="20 Dec 2029" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
